VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL=https://your-project.supabase.co/
VITE_ENCRYPTION_KEY="your-secure-encryption-key-change-in-production"

# New custom backend (backend/). Leave unset in browser dev - the Vite dev
# server proxies /api to it (see vite.config.ts). Required for the Tauri
# build, which has no dev proxy and must hit the API's real origin.
VITE_API_URL=http://127.0.0.1:4000