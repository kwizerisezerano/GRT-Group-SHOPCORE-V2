// ShopCore MySQL schema.
//
// Reconstructed from the Supabase/Postgres migrations in supabase/migrations/
// and, for tables that only ever existed on the live Supabase project (never
// committed as a migration), from the SQL bodies of the Postgres RPC
// functions and edge functions that reference them. Columns seen directly in
// an `insert`/`select` statement in that source SQL are confident; columns
// marked "guessed" below were not directly observed and are a best-effort
// reconstruction pending validation against real usage.
//
// Conventions:
//   uuid                        -> String @db.Char(36), app/Prisma-generated v4 uuid()
//   text                        -> @db.Text (unbounded) or VarChar (bounded/indexed)
//   numeric                     -> Decimal @db.Decimal(14, 2)
//   timestamp with time zone    -> DateTime (stored as UTC by convention; MySQL has no true timestamptz)
//   jsonb                       -> Json
//   Postgres RLS / auth.uid()   -> no MySQL equivalent; enforced in application code via
//                                  req.user.tenantId + explicit `where: { tenantId }` on every query.
//   tenant_id nullable in the   -> tightened to NOT NULL here where every real row always has one
//   source (RLS did enforcement)  (RLS is gone, so the column itself must not silently allow orphans)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Auth / tenant bootstrap (Phase 1 — fully implemented with service code)
// =========================================================================

model User {
  id                   String    @id @default(uuid()) @db.Char(36)
  // PII is never stored in the clear. `*Encrypted` columns hold AES-256-GCM
  // envelopes (lib/crypto.ts); `*Hash` columns hold the keyed HMAC-SHA256
  // blind index that makes the value searchable and uniquely constrainable
  // without being readable. Never query the encrypted column directly —
  // look up by hash.
  emailEncrypted       String    @map("email_encrypted") @db.VarChar(512)
  emailHash            String    @unique @map("email_hash") @db.Char(64)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt      DateTime? @map("email_verified_at")
  displayNameEncrypted String?   @map("display_name_encrypted") @db.VarChar(512)
  isPlatformAdmin      Boolean   @default(false) @map("is_platform_admin")

  /// A short numeric PIN, bcrypt-hashed, that a platform admin re-enters before
  /// attaching ShopCore's own signature or stamp to a contract template. The
  /// session proves who signed in; the PIN proves the person at the keyboard is
  /// still them at the moment a legally binding mark is applied.
  signingPinHash           String?   @map("signing_pin_hash") @db.VarChar(255)
  signingPinSetAt          DateTime? @map("signing_pin_set_at")
  /// Wrong tries since the last success, and the lockout they earned. A four
  /// digit PIN is guessable in ten thousand tries without this.
  signingPinFailedAttempts Int       @default(0) @map("signing_pin_failed_attempts")
  signingPinLockedUntil    DateTime? @map("signing_pin_locked_until")
  // Free-form signup metadata (business name/phone/location/type/team size, etc.)
  // captured at signup time, before a tenant exists. Not the source of truth
  // once a tenant/profile is created — mirrors Supabase's raw_user_meta_data
  // role for continuity only.
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  profile              Profile?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  loginOtps            LoginOtp[]
  tenantMemberships    TenantMember[]
  ownedTenants         Tenant[]             @relation("TenantOwner")
  userRoles            UserRole[]
  workspaceMemberships WorkspaceMember[]
  sales                Sale[]
  memberPermissions    MemberPermission[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time codes for the second factor asked for after a member sets their
/// own password for the first time. Only the SHA-256 of the code is stored,
/// the same way refresh and reset tokens are held, so a database read cannot
/// hand somebody a working code. Rows are consumed on use and expire quickly.
model LoginOtp {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  codeHash   String    @map("code_hash") @db.Char(64)
  purpose    String    @default("login") @db.VarChar(32)
  /// Guards against brute-forcing a six-digit code; the row is spent once
  /// this passes the service's limit.
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_otps")
}

model Profile {
  id                   String   @id @db.Char(36) // shares PK with User (1:1) — matches Supabase's profiles.id = auth.users.id
  tenantId             String?  @map("tenant_id") @db.Char(36) // nullable: not set until a workspace/tenant exists
  // Encrypted server-side on write (lib/crypto.ts). phoneHash is unique so
  // the same number cannot be registered against two profiles; MySQL permits
  // repeated NULLs, so profiles without a phone are unaffected.
  displayNameEncrypted String?  @map("display_name_encrypted") @db.VarChar(512)
  phoneEncrypted       String?  @map("phone_encrypted") @db.VarChar(512)
  phoneHash            String?  @unique @map("phone_hash") @db.Char(64)
  language             String   @default("en") @db.VarChar(8) // see src/i18n SUPPORTED_LANGUAGES: en | fr | es | sw | rw
  planId               String?  @map("plan_id") @db.Char(36)
  avatarUrl            String?  @map("avatar_url") @db.VarChar(512)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [id], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  qaAuditLogs      QaAuditLog[]
  qaFilterPresets  QaFilterPreset[]  @relation("QaFilterPresetCreatedBy")
  qaIsolationLeaks QaIsolationLeak[] @relation("QaIsolationLeakDetectedBy")
  qaRuns           QaRun[]           @relation("QaRunCreatedBy")
  qaScreenshots    QaScreenshot[]    @relation("QaScreenshotCreatedBy")
  staff            Staff[]

  @@index([tenantId])
  @@map("profiles")
}

model Tenant {
  id                    String    @id @default(uuid()) @db.Char(36)
  name                  String    @db.VarChar(191)
  ownerId               String?   @map("owner_id") @db.Char(36)
  /// Rwanda Revenue Authority TIN, captured at signup for the contract and
  /// for invoices. Not encrypted: a TIN is printed on every invoice a business
  /// issues, so it is not a secret, and support has to be able to search it.
  tinNumber             String?   @map("tin_number") @db.VarChar(32)
  // Not unique: several tenants may legitimately share a billing contact.
  // Indexed so support tooling can still find a tenant by contact address.
  contactEmailEncrypted String?   @map("contact_email_encrypted") @db.VarChar(512)
  contactEmailHash      String?   @map("contact_email_hash") @db.Char(64)
  slug                  String?   @db.VarChar(191)
  logoUrl               String?   @map("logo_url") @db.VarChar(512)
  brandColor            String?   @default("#2563eb") @map("brand_color") @db.VarChar(16)
  // V2's live `tenants` table doesn't actually have these columns even
  // though AuthContext/offlineAuth/Login all query them via tenants!inner(...)
  // - a real pre-existing schema-drift bug on that branch. Fixed here rather
  // than reproduced, since MySQL is a clean start.
  subscriptionPlan      String?   @map("subscription_plan") @db.VarChar(64)
  subscriptionStatus    String?   @map("subscription_status") @db.VarChar(32)
  paymentStatus         String?   @map("payment_status") @db.VarChar(32)
  trialStatus           String?   @map("trial_status") @db.VarChar(32)
  trialEndsAt           DateTime? @map("trial_ends_at")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  workspaceStatus       String?   @map("workspace_status") @db.VarChar(32)
  billingCycle          String?   @map("billing_cycle") @db.VarChar(16)
  createdAt             DateTime  @default(now()) @map("created_at")

  owner               User?                             @relation("TenantOwner", fields: [ownerId], references: [id])
  members             TenantMember[]
  profiles            Profile[]
  userRoles           UserRole[]
  subscriptions       TenantSubscription[]
  moduleEntitlements  PlatformTenantModuleEntitlement[]
  limitOverrides      TenantLimitOverride[]
  paymentTransactions PaymentTransaction[]
  paymentLogs         PaymentLog[]
  signedContracts     SignedContract[]

  brands            Brand[]
  categories        Category[]
  creditedItems     CreditedItem[]
  customers         Customer[]
  expenses          Expense[]
  expiredProducts   ExpiredProduct[]
  invoiceCounters   InvoiceCounter[]
  subscriptionInvoices SubscriptionInvoice[]
  units             Unit[]
  branches          Branch[]
  rolePermissions   RolePermission[]
  userInvites       UserInvite[]
  activityLogs      ActivityLog[]
  products          Product[]
  purchases         Purchase[]
  qaAuditLogs       QaAuditLog[]
  qaFilterPresets   QaFilterPreset[]
  qaIsolationLeaks  QaIsolationLeak[]
  qaRuns            QaRun[]
  qaScreenshots     QaScreenshot[]
  qaSettings        QaSetting[]
  sales             Sale[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  suppliers         Supplier[]
  staff             Staff[]
  memberPermissions MemberPermission[]

  @@index([contactEmailHash])
  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      String   @default("member") @db.VarChar(32)
  isDefault Boolean  @default(true) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  /// Where this member works, and in what capacity.
  ///
  /// The admin screen has offered these for as long as it has existed and
  /// nothing ever stored them: it wrote branch_id, department and status
  /// straight to Supabase against columns this database never had, so every
  /// save reported success and changed nothing.
  ///
  /// Null branch means the whole workspace rather than one shop — a roaming
  /// manager, or a workspace that has not set any branches up yet. On the wire
  /// the screen calls that "all".
  branchId   String? @map("branch_id") @db.Char(36)
  department String? @db.VarChar(191)
  /// Whether the membership is live. Suspending is not removing: the person
  /// keeps their history, their role and their audit trail, and stops being
  /// able to sign in to this workspace.
  status     String  @default("active") @db.VarChar(32)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: closing a shop must not delete the people who
  /// worked in it. They fall back to workspace-wide until reassigned.
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // The source Postgres migration's own comments document a live bug where
  // an ON CONFLICT clause targeted a unique constraint that never existed on
  // this table. Add the real constraint here.
  @@unique([userId, tenantId], name: "tenant_members_user_tenant_unique")
  @@map("tenant_members")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tenantId  String?  @map("tenant_id") @db.Char(36)
  role      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role], name: "user_roles_unique")
  @@map("user_roles")
}

/// Per-workspace adjustments to what a role may do.
///
/// The shipped defaults in lib/permissions.ts are what a role means when
/// nobody has said otherwise; rows here are a workspace's own grants and
/// revocations on top. Storing only the differences — rather than seeding a
/// full matrix per tenant — means a workspace that customised one role still
/// picks up sensible access to modules shipped afterwards, with no data
/// migration.
model RolePermission {
  id         String   @id @default(uuid()) @db.Char(36)
  tenantId   String   @map("tenant_id") @db.Char(36)
  role       String   @db.VarChar(32)
  permission String   @db.VarChar(64)
  /// true = granted beyond the default, false = revoked from it.
  granted    Boolean  @default(true)
  updatedBy  String?  @map("updated_by") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permission])
  @@index([tenantId])
  @@map("role_permissions")
}

/// An invitation for someone to join a workspace in a named role.
///
/// The token is stored as a hash, never in the clear: an invite link is a
/// credential until it is used, and a leaked database should not hand out
/// workspace access. The email is encrypted like every other address, with a
/// blind index so a pending invite can still be found by the address it went
/// to.
model UserInvite {
  id             String    @id @default(uuid()) @db.Char(36)
  tenantId       String    @map("tenant_id") @db.Char(36)
  emailEncrypted String    @map("email_encrypted") @db.VarChar(512)
  emailHash      String    @map("email_hash") @db.Char(64)
  role           String    @db.VarChar(32)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(16)
  invitedBy      String?   @map("invited_by") @db.Char(36)
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  acceptedBy     String?   @map("accepted_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One live invite per address per workspace. Enforced in application code
  /// against status rather than by a partial index, which MySQL lacks.
  @@index([tenantId, emailHash])
  @@index([tenantId, status])
  @@map("user_invites")
}

/// Who did what, and when.
///
/// Written for the changes where "it was like that when I got here" is not an
/// acceptable answer — someone's role changing, a permission being granted, a
/// member being removed. Append-only by convention: there is no update or
/// delete path in the API.
model ActivityLog {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @map("tenant_id") @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  actorLabel  String?  @map("actor_label") @db.VarChar(191)
  action      String   @db.VarChar(64)
  module      String?  @db.VarChar(64)
  targetId    String?  @map("target_id") @db.Char(36)
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@map("activity_logs")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  members WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  role        String   @default("owner") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_members")
}

// =========================================================================
// Billing / subscriptions.
//
// V2's actual schema (supabase/migrations/20260529073325_remote_schema.sql)
// has no subscription_invoices/invoice_items/subscription_history/
// subscription_events tables at all (those were main-branch-only) - its
// billing model is just tenant_subscriptions + payment_methods, with a
// built-in approval workflow (approval_status/requested_*/approved_*
// columns, driven by approve_subscription()/reject_subscription() RPCs).
//
// Per the migration decision for this pass: the approval workflow's
// SERVICE logic (admin approve/reject endpoints, the "pending approval"
// login redirect) is deferred to a later phase, matching how billing/
// platform-admin CRUD is deferred on the main branch. The schema below
// still carries the approval columns so that later phase is additive, not
// a migration rewrite - new subscriptions are just created pre-approved
// (approvalStatus: "approved") until that phase builds the real gate.
// =========================================================================

/// A commercial package a workspace can be on.
///
/// The platform console owns these rows outright (platform/plans.routes.ts):
/// a super admin writes the name, the price per billing cycle, the ceilings
/// the plan imposes (SubscriptionPlanLimit) and the modules it opens
/// (SubscriptionPlanFeature). Nothing here is seeded-and-frozen — the seed
/// only puts a sensible starting catalogue in place.
model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Char(36)
  code         String   @unique @db.VarChar(32) // starter | professional | business_plus | enterprise_pro
  name         String   @db.VarChar(191)
  /// One line under the plan name on the pricing table.
  tagline      String?  @db.VarChar(255)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  /// Whether the public signup/pricing screens may offer it. An inactive or
  /// private plan is still assignable by a platform admin — that is how a
  /// negotiated or legacy package keeps working after it leaves the shelf.
  isPublic     Boolean  @default(true) @map("is_public")
  isPopular    Boolean  @default(false) @map("is_popular")
  badgeText    String?  @map("badge_text") @db.VarChar(64)
  /// Days of free use granted when a workspace starts on this plan. 0 = none.
  trialDays    Int      @default(0) @map("trial_days")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  prices   SubscriptionPlanPrice[]
  limits   SubscriptionPlanLimit[]
  features SubscriptionPlanFeature[]

  @@map("subscription_plans")
}

/// One ceiling a plan imposes — "3 users", "2 branches", "unlimited products".
///
/// Stored as rows rather than as a JSON blob on the plan because they are
/// read on the hot path: every attempt to create a member, a branch or a
/// product resolves the tenant's limits (lib/planLimits.ts) and compares them
/// against live counts. Rows also mean a platform admin can add a brand-new
/// ceiling to one plan without a migration.
///
/// `value` is the ceiling; `isUnlimited` overrides it. A limit key that has no
/// row at all is treated as unlimited, so a plan never accidentally blocks a
/// capacity nobody has priced yet.
model SubscriptionPlanLimit {
  id           String   @id @default(uuid()) @db.Char(36)
  planCode     String   @map("plan_code") @db.VarChar(32)
  /// users | branches | warehouses | products | customers | suppliers |
  /// pos_terminals | desktop_devices | storage_gb | monthly_transactions
  limitKey     String   @map("limit_key") @db.VarChar(64)
  name         String   @db.VarChar(191)
  value        Int?
  isUnlimited  Boolean  @default(false) @map("is_unlimited")
  unit         String?  @db.VarChar(32)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@unique([planCode, limitKey], name: "plan_limit_unique")
  @@index([planCode])
  @@map("subscription_plan_limits")
}

/// What a plan opens up: the modules and capabilities a workspace on it may
/// reach. Consumed by the frontend's plan-access layer (AuthContext
/// getModuleAccess / PlanGuard), which treats an empty feature list as
/// "allow everything" — so a plan with no rows here is permissive, not dead.
model SubscriptionPlanFeature {
  id            String   @id @default(uuid()) @db.Char(36)
  planCode      String   @map("plan_code") @db.VarChar(32)
  featureKey    String   @map("feature_key") @db.VarChar(64)
  name          String   @db.VarChar(191)
  description   String?  @db.Text
  category      String   @default("modules") @db.VarChar(64)
  /// included | limited | addon | unavailable
  accessLevel   String   @default("included") @map("access_level") @db.VarChar(16)
  displayNote   String?  @map("display_note") @db.VarChar(255)
  isHighlighted Boolean  @default(false) @map("is_highlighted")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@unique([planCode, featureKey], name: "plan_feature_unique")
  @@index([planCode])
  @@map("subscription_plan_features")
}

/// A ceiling raised (or lowered) for one workspace, on top of whatever its
/// plan says.
///
/// Every business eventually negotiates one extra seat rather than a whole
/// tier. Without this the only way to grant that is to invent a bespoke plan,
/// which then has to be maintained forever. An override is scoped to the
/// tenant and wins over the plan row for that one key.
model TenantLimitOverride {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @map("tenant_id") @db.Char(36)
  limitKey    String   @map("limit_key") @db.VarChar(64)
  value       Int?
  isUnlimited Boolean  @default(false) @map("is_unlimited")
  note        String?  @db.VarChar(255)
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, limitKey], name: "tenant_limit_override_unique")
  @@index([tenantId])
  @@map("tenant_limit_overrides")
}

model SubscriptionPlanPrice {
  id              String   @id @default(uuid()) @db.Char(36)
  planCode        String   @map("plan_code") @db.VarChar(32)
  billingCycle    String   @map("billing_cycle") @db.VarChar(16) // monthly | six_months | annual
  billingMonths   Int?     @map("billing_months") // guessed
  listPrice       Decimal  @map("list_price") @db.Decimal(14, 2)
  finalPrice      Decimal  @map("final_price") @db.Decimal(14, 2)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2) // guessed
  currency        String   @default("RWF") @db.VarChar(8)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  /// Cascades with the plan, the same way its limits and features do. A price
  /// row that outlives the plan it prices is not data, it is an orphan that
  /// blocks the delete - which is exactly what it did until this was set.
  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@unique([planCode, billingCycle], name: "plan_price_unique")
  @@map("subscription_plan_prices")
}

// Read-optimized denormalized catalog consumed by the public signup/pricing
// UI (`public_subscription_plan_catalog` in the source). Modeled as a real
// table (populated by the seed script alongside SubscriptionPlan/Price)
// rather than a MySQL view, since it needs to carry nested JSON.
model PublicSubscriptionPlanCatalog {
  id       String  @id @default(uuid()) @db.Char(36)
  code     String  @unique @db.VarChar(32)
  name     String  @db.VarChar(191)
  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(true) @map("is_public")
  features Json?
  limits   Json?
  prices   Json?

  @@map("public_subscription_plan_catalog")
}

model PaymentMethod {
