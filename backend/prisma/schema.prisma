}

/// A contract a customer signs before paying for a subscription.
///
/// Platform-wide and edited only by a platform admin: this is ShopCore's
/// agreement with its customers, not a document any one workspace owns.
///
/// ## Placeholders, not per-customer copies
///
/// The body carries `{{placeholders}}` — company name, TIN, plan, amount,
/// period — filled at the moment a customer is shown it. Storing a rendered
/// copy per customer instead would mean a wording correction never reaching
/// anyone who signed up before it, and no way to answer "what does our current
/// contract say".
///
/// Exactly one template is active at a time. `isActive` is enforced in the
/// service rather than by a constraint, because MySQL has no partial unique
/// index to express "at most one row with true".
model ContractTemplate {
  id        String   @id @default(uuid()) @db.Char(36)
  /// Shown in the console list — "Standard subscription agreement 2026".
  name      String   @db.VarChar(191)
  /// Optional note for whoever maintains these.
  description String? @db.Text
  /// The agreement itself, with {{placeholders}}.
  body      String   @db.LongText
  /// Only one template is served to customers at a time.
  isActive  Boolean  @default(false) @map("is_active")
  /// Bumped on every save, so a signed contract can name the exact wording.
  version   Int      @default(1)

  /// ShopCore's own signature, as a PNG/JPEG data URL. Applied to every
  /// contract issued from this template, so the agreement is countersigned
  /// rather than signed by one party.
  providerSignatureImage String? @map("provider_signature_image") @db.LongText
  /// ShopCore's company stamp. Optional, like the customer's.
  providerStampImage     String? @map("provider_stamp_image") @db.LongText
  /// Printed under the provider's signature — "Patrick Yumvagusenga, Director".
  providerSignerName     String? @map("provider_signer_name") @db.VarChar(191)
  providerSignerTitle    String? @map("provider_signer_title") @db.VarChar(191)

  /// Who ShopCore is, in the legal sense, on the face of the document.
  ///
  /// A contract names both parties by their registered identity — not just a
  /// brand. Without these the customer's side of the agreement is fully
  /// identified (name, TIN, address) and the provider's side reads "ShopCore",
  /// which is the half of the document that would be argued about first.
  /// Editable per template so a change of registered address does not require
  /// a code change, and snapshotted onto every signature.
  providerLegalName      String? @map("provider_legal_name") @db.VarChar(191)
  providerTin            String? @map("provider_tin") @db.VarChar(32)
  providerRegistrationNo String? @map("provider_registration_no") @db.VarChar(64)
  providerAddress        String? @map("provider_address") @db.VarChar(255)
  providerEmail          String? @map("provider_email") @db.VarChar(191)
  providerPhone          String? @map("provider_phone") @db.VarChar(32)
  /// Whose courts decide a dispute — printed in the execution block and
  /// available to the body as {{governing_law}}.
  governingLaw           String? @map("governing_law") @db.VarChar(191)

  /// Who last attached the signature or stamp, and when they confirmed it with
  /// their PIN. The mark is what binds ShopCore, so the record of who applied
  /// it belongs next to it rather than only in a log.
  signatureAttachedBy    String?   @map("signature_attached_by") @db.Char(36)
  signatureAttachedAt    DateTime? @map("signature_attached_at")

  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signatures SignedContract[]

  @@index([isActive])
  @@map("contract_templates")
}

/// A contract as one customer actually signed it.
///
/// The rendered text is stored in full rather than as a pointer at the
/// template. Templates are edited over time, and a contract has to say what was
/// agreed on the day it was agreed — resolving it live would silently rewrite
/// the history of every signature each time the wording changed.
model SignedContract {
  id                   String  @id @default(uuid()) @db.Char(36)
  tenantId             String  @map("tenant_id") @db.Char(36)
  /// Nullable on purpose: deleting a template must not delete the record of
  /// what somebody signed.
  templateId           String? @map("template_id") @db.Char(36)
  templateName         String  @map("template_name") @db.VarChar(191)
  templateVersion      Int     @map("template_version")

  /// The exact text shown to the signer, placeholders already filled.
  body                 String  @db.LongText

  signerName           String  @map("signer_name") @db.VarChar(191)
  signerEmailEncrypted String? @map("signer_email_encrypted") @db.VarChar(512)

  /// The customer's registered identity as it stood at signing, so the parties
  /// block on a re-downloaded PDF is as complete as the body already is.
  /// TIN and trading address follow Tenant.tinNumber and are stored in the
  /// clear — both are printed on every invoice the business issues. The phone
  /// number is personal data and is not.
  customerLegalName    String? @map("customer_legal_name") @db.VarChar(191)
  customerTin          String? @map("customer_tin") @db.VarChar(32)
  customerAddress      String? @map("customer_address") @db.VarChar(255)
  customerPhoneEncrypted String? @map("customer_phone_encrypted") @db.VarChar(512)
  /// The drawn signature, as a PNG data URL.
  signatureImage       String  @map("signature_image") @db.LongText
  /// The company stamp. Optional — many small retailers do not have one.
  stampImage           String? @map("stamp_image") @db.LongText

  /// The provider's side, copied from the template at signing time.
  providerSignatureImage String? @map("provider_signature_image") @db.LongText
  providerStampImage     String? @map("provider_stamp_image") @db.LongText
  providerSignerName     String? @map("provider_signer_name") @db.VarChar(191)
  providerSignerTitle    String? @map("provider_signer_title") @db.VarChar(191)

  /// The provider's registered identity, copied at signing for the same reason
  /// the body is: the document has to say who it bound on the day it was made,
  /// and ShopCore moving office must not rewrite an existing agreement.
  providerLegalName      String? @map("provider_legal_name") @db.VarChar(191)
  providerTin            String? @map("provider_tin") @db.VarChar(32)
  providerRegistrationNo String? @map("provider_registration_no") @db.VarChar(64)
  providerAddress        String? @map("provider_address") @db.VarChar(255)
  providerEmail          String? @map("provider_email") @db.VarChar(191)
  providerPhone          String? @map("provider_phone") @db.VarChar(32)
  governingLaw           String? @map("governing_law") @db.VarChar(191)

  /// What was agreed, denormalised so the record stands on its own.
  planCode             String  @map("plan_code") @db.VarChar(32)
  planName             String  @map("plan_name") @db.VarChar(191)
  billingCycle         String  @map("billing_cycle") @db.VarChar(16)
  amount               Decimal @db.Decimal(12, 2)
  currency             String  @default("RWF") @db.VarChar(8)

  signedAt DateTime @default(now()) @map("signed_at")
  signedIp String?  @map("signed_ip") @db.VarChar(64)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([templateId])
  @@map("signed_contracts")
}
