  tenantId        String    @map("tenant_id") @db.Char(36)
  supplierId      String?   @map("supplier_id") @db.Char(36)
  supplierName    String?   @map("supplier_name") @db.VarChar(191)
  purchaseNo      String?   @map("purchase_no") @db.VarChar(64)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  tax             Decimal   @default(0) @db.Decimal(14, 2)
  discount        Decimal   @default(0) @db.Decimal(14, 2)
  status          String?   @default("completed") @db.VarChar(32)
  paymentStatus   String?   @default("paid") @map("payment_status") @db.VarChar(32)
  notes           String?   @db.Text
  userId          String?   @map("user_id") @db.Char(36)
  purchaseDate    DateTime  @default(now()) @map("purchase_date")
  /// Idempotency key — see the Sale model. A goods receipt recorded twice
  /// inflates stock just as surely as a sale recorded twice deflates it.
  clientRequestId String?   @map("client_request_id") @db.VarChar(64)
  source          String?   @default("online") @db.VarChar(16)
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

