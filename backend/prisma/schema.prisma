// =========================================================================
// Payment gateway (LMBTech Pay - MTN MoMo, Airtel Money, card via Pesapal).
//
// One row per attempt to move money, and an append-only trail of every
// exchange with the gateway beside it. The pair exists because a payment is
// the one part of this system whose failures are argued about after the
// fact: "the customer says they paid" is answerable only if the request, the
// gateway's answer and the callback it later posted are all still on disk.
// =========================================================================

/// One attempt to collect from (or pay out to) a customer.
///
/// `referenceId` is ours and is what every gateway call is keyed on - the
/// initiate response, the status poll and the callback all carry it back. It
/// is unique so a duplicated callback updates the same row rather than
/// creating a second one.
model PaymentTransaction {
  id                  String    @id @default(uuid()) @db.Char(36)
  referenceId         String    @unique @map("reference_id") @db.VarChar(64)
  tenantId            String?   @map("tenant_id") @db.Char(36)
  subscriptionId      String?   @map("subscription_id") @db.Char(36)
  userId              String?   @map("user_id") @db.Char(36)
  /// subscription | renewal | payout | other
  purpose             String    @default("subscription") @db.VarChar(32)
  /// collection (money in) | payout (money out)
  direction           String    @default("collection") @db.VarChar(16)
  provider            String    @default("lmbtech") @db.VarChar(32)
  /// The gateway's own transaction id, learned from the callback or a status
  /// poll. Null until the gateway has said anything about this reference.
  providerTxnId       String?   @map("provider_txn_id") @db.VarChar(128)
  /// Our PaymentMethod.code (mobile_money_mtn, card, ...).
  paymentMethodCode   String?   @map("payment_method_code") @db.VarChar(32)
  /// What was actually put on the wire (MTN_MOMO_RWA, AIRTEL_MONEY_RWA, card).
  gatewayMethod       String?   @map("gateway_method") @db.VarChar(32)
  /// Payer identity is PII and is encrypted at rest like every other address
  /// and number in this schema (lib/crypto.ts). Nothing looks a payment up by
  /// payer, so there is no blind index.
  payerPhoneEncrypted String?   @map("payer_phone_encrypted") @db.VarChar(512)
  payerEmailEncrypted String?   @map("payer_email_encrypted") @db.VarChar(512)
  payerNameEncrypted  String?   @map("payer_name_encrypted") @db.VarChar(512)
  amount              Decimal   @db.Decimal(14, 2)
  currency            String    @default("RWF") @db.VarChar(8)
  /// pending | success | failed | cancelled
  status              String    @default("pending") @db.VarChar(16)
  /// The gateway's own wording for why, kept verbatim for support.
  statusDetail        String?   @map("status_detail") @db.Text
  /// Card payments only: where the customer was sent to enter their details.
  redirectUrl         String?   @map("redirect_url") @db.VarChar(768)
  servicePaid         String?   @map("service_paid") @db.VarChar(191)
  planCode            String?   @map("plan_code") @db.VarChar(32)
  billingCycle        String?   @map("billing_cycle") @db.VarChar(16)
  /// How many times the gateway has told us about this reference. A second
  /// callback for an already-settled payment is normal and must be harmless.
  callbackCount       Int       @default(0) @map("callback_count")
  initiatedAt         DateTime  @default(now()) @map("initiated_at")
  completedAt         DateTime? @map("completed_at")
  lastCallbackAt      DateTime? @map("last_callback_at")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  logs         PaymentLog[]
  invoice      SubscriptionInvoice?

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([subscriptionId])
  @@map("payment_transactions")
}

/// Append-only record of one exchange with the gateway.
///
/// Written for the request we sent, the answer we got, every callback that
/// arrived and every failure in between. Payloads are stored with the payer's
/// phone, email and name masked (lib/payments/redact.ts): a log that has to
/// be readable by support must not be a second, unencrypted copy of the
/// personal data the transaction row is careful to encrypt.
model PaymentLog {
  id              String   @id @default(uuid()) @db.Char(36)
  transactionId   String?  @map("transaction_id") @db.Char(36)
  referenceId     String?  @map("reference_id") @db.VarChar(64)
  tenantId        String?  @map("tenant_id") @db.Char(36)
  /// request | response | callback | status_check | error
  direction       String   @db.VarChar(16)
  /// collection.initiate | payout.initiate | callback.received | ...
  event           String   @db.VarChar(64)
  provider        String   @default("lmbtech") @db.VarChar(32)
  httpStatus      Int?     @map("http_status")
  /// pending | success | failed | cancelled, as understood after this entry.
  resultStatus    String?  @map("result_status") @db.VarChar(16)
  message         String?  @db.Text
  requestPayload  Json?    @map("request_payload")
  responsePayload Json?    @map("response_payload")
  errorMessage    String?  @map("error_message") @db.Text
  durationMs      Int?     @map("duration_ms")
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@index([referenceId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("payment_logs")
}

// =========================================================================
// Core ERP/POS tables — schema stubs only in Phase 1 (no service code yet,
// built out module-by-module starting Phase 2). Included now so the initial
// migration produces the full target schema in one file.
// =========================================================================

model Brand {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  name      String   @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

/// Units of measure — "piece", "kg", "carton".
///
/// Products carry their unit as a plain string (`Product.unit`), which is
/// deliberate: a product's unit is a label on that product, and pointing it at
/// a row that can be renamed or deleted underneath it buys nothing. This table
/// is the tenant's own list to choose from, not a foreign key.
/// A shop, outlet or site belonging to one workspace.
///
/// Contact details are personal data even when they belong to a place: a
/// branch phone is usually a person's phone. Encrypted like every other, with
/// no blind index because nothing looks a branch up by them.
model Branch {
  id             String    @id @default(uuid()) @db.Char(36)
  tenantId       String    @map("tenant_id") @db.Char(36)
  name           String    @db.VarChar(191)
  code           String?   @db.VarChar(64)
  manager        String?   @db.VarChar(191)
  phoneEncrypted String?   @map("phone_encrypted") @db.VarChar(512)
  emailEncrypted String?   @map("email_encrypted") @db.VarChar(512)
  address        String?   @db.Text
  city           String?   @db.VarChar(191)
  type           String?   @db.VarChar(32)
  status         String?   @default("active") @db.VarChar(32)
  openingDate    DateTime? @map("opening_date")
  operatingHours String?   @map("operating_hours") @db.VarChar(191)
  taxNumber      String?   @map("tax_number") @db.VarChar(64)
  notes          String?   @db.Text
  /// Exactly one per workspace, kept true by the module rather than by a
  /// constraint: MySQL cannot express "at most one row where this is true".
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members TenantMember[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

model Unit {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @map("tenant_id") @db.Char(36)
  name         String   @db.VarChar(191)
  abbreviation String?  @db.VarChar(32)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("units")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @map("tenant_id") @db.Char(36)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Supplier {
  id               String   @id @default(uuid()) @db.Char(36)
  tenantId         String   @map("tenant_id") @db.Char(36)
  // Same per-tenant encryption/uniqueness treatment as Customer.
  nameEncrypted    String   @map("name_encrypted") @db.VarChar(512)
  phoneEncrypted   String?  @map("phone_encrypted") @db.VarChar(512)
  phoneHash        String?  @map("phone_hash") @db.Char(64)
  emailEncrypted   String?  @map("email_encrypted") @db.VarChar(512)
  emailHash        String?  @map("email_hash") @db.Char(64)
  addressEncrypted String?  @map("address_encrypted") @db.Text
  userId           String?  @map("user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, emailHash])
  @@unique([tenantId, phoneHash])
  @@index([tenantId])
  @@map("suppliers")
}

model Product {
  id            String    @id @default(uuid()) @db.Char(36)
  tenantId      String    @map("tenant_id") @db.Char(36)
  name          String    @db.VarChar(191)
  barcode       String?   @db.VarChar(64)
  sku           String?   @db.VarChar(64)
  // categoryId/brandId are the source of truth. `category`/`categoryName`/
  // `brand` are denormalised copies of the related row's name, kept for
  // list-view performance and read directly by the existing UI. The product
  // service writes all of them from the id in one place, so they cannot
  // drift apart — never set them independently.
  category      String?   @db.VarChar(191)
  categoryId    String?   @map("category_id") @db.Char(36)
  categoryName  String?   @map("category_name") @db.VarChar(191)
  brand         String?   @db.VarChar(191)
  brandId       String?   @map("brand_id") @db.Char(36)
  supplierId    String?   @map("supplier_id") @db.Char(36)
  costPrice     Decimal   @default(0) @map("cost_price") @db.Decimal(14, 2)
  sellingPrice  Decimal   @default(0) @map("selling_price") @db.Decimal(14, 2)
  stock         Int       @default(0)
  stockQuantity Int       @default(0) @map("stock_quantity")
  minStock      Int       @default(0) @map("min_stock")
  minStockLevel Int       @default(5) @map("min_stock_level")
  taxRate       Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  imageUrl      String?   @map("image_url") @db.VarChar(512)
  description   String?   @db.Text
  unit          String?   @default("pcs") @db.VarChar(32)
  status        String?   @default("active") @db.VarChar(32)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  userId        String?   @map("user_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditedItems   CreditedItem[]
  expiredProducts ExpiredProduct[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]

  // A SKU and a barcode identify one product within a business. Unique per
  // tenant, not globally: two businesses may legitimately stock the same
  // barcode. MySQL permits repeated NULLs, so products without either are
  // unaffected.
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@map("products")
}

model Customer {
  id               String   @id @default(uuid()) @db.Char(36)
  tenantId         String   @map("tenant_id") @db.Char(36)
  // Encrypted at rest (lib/crypto.ts). The hashes are unique *per tenant*
  // rather than globally — the same person may be a customer of two
  // different businesses on the platform, but must not be duplicated within
  // one of them. See the @@unique declarations below.
  nameEncrypted    String   @map("name_encrypted") @db.VarChar(512)
  phoneEncrypted   String?  @map("phone_encrypted") @db.VarChar(512)
  phoneHash        String?  @map("phone_hash") @db.Char(64)
  emailEncrypted   String?  @map("email_encrypted") @db.VarChar(512)
  emailHash        String?  @map("email_hash") @db.Char(64)
  addressEncrypted String?  @map("address_encrypted") @db.Text
  totalSpent       Decimal  @default(0) @map("total_spent") @db.Decimal(14, 2)
  loyaltyPoints    Int      @default(0) @map("loyalty_points")
  status           String?  @default("active") @db.VarChar(32)
  userId           String?  @map("user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditedItems CreditedItem[]

  @@unique([tenantId, emailHash])
  @@unique([tenantId, phoneHash])
  @@index([tenantId])
  @@map("customers")
}

model Sale {
  id                     String    @id @default(uuid()) @db.Char(36)
  tenantId               String    @map("tenant_id") @db.Char(36)
  invoiceNo              String    @map("invoice_no") @db.VarChar(64)
  saleNo                 String?   @map("sale_no") @db.VarChar(64)
  receiptNo              String?   @map("receipt_no") @db.VarChar(64)
  /// Idempotency key, chosen by the till when the sale is first attempted and
  /// reused for every retry of that same sale. It is what makes a checkout
  /// safe to send twice: the unique index below means a replay cannot create a
  /// second sale, so a connection that drops after the server committed but
  /// before the answer arrived costs nothing.
  clientRequestId        String?   @map("client_request_id") @db.VarChar(64)
  /// "online" for a sale recorded as it happened, "offline" for one taken on a
  /// disconnected till and replayed later. Worth keeping: an offline sale is
  /// allowed to drive stock negative, because the goods physically left the
  /// shop whatever the database believed at the time.
  source                 String?   @default("online") @db.VarChar(16)
  /// When the till actually completed the sale, which for an offline sale is
  /// earlier — sometimes much earlier — than when the server first saw it.
  completedAt            DateTime? @map("completed_at")
  customerName           String?   @map("customer_name") @db.VarChar(191)
  // A walk-in customer's phone and tax number are personal data just as much
  // as a registered customer's, so they get the same treatment as everywhere
  // else: AES-256-GCM at rest, with a blind index on the phone so a shop can
  // still look a buyer up by number. Not unique — one person may buy twice.
  customerPhoneEncrypted String?   @map("customer_phone_encrypted") @db.VarChar(512)
  customerPhoneHash      String?   @map("customer_phone_hash") @db.Char(64)
  customerTinEncrypted   String?   @map("customer_tin_encrypted") @db.VarChar(512)
  items                  Int       @default(0)
  subtotal               Decimal   @default(0) @db.Decimal(14, 2)
  tax                    Decimal   @default(0) @db.Decimal(14, 2)
  discount               Decimal   @default(0) @db.Decimal(14, 2)
  total                  Decimal   @default(0) @db.Decimal(14, 2)
  paid                   Decimal   @default(0) @db.Decimal(14, 2)
  due                    Decimal   @default(0) @db.Decimal(14, 2)
  changeGiven            Decimal   @default(0) @map("change_given") @db.Decimal(14, 2)
  // Margin is stored, not recomputed on read: cost prices move, and a sale's
  // profit is a fact about the moment it happened.
  costTotal              Decimal   @default(0) @map("cost_total") @db.Decimal(14, 2)
  grossProfit            Decimal   @default(0) @map("gross_profit") @db.Decimal(14, 2)
  paymentMethod          String?   @map("payment_method") @db.VarChar(32)
  // Mobile-money reference. The number is a phone number, so it is encrypted;
  // the transaction code is not personal data and stays readable for
  // reconciliation against the provider's statement.
  momoNumberEncrypted    String?   @map("momo_number_encrypted") @db.VarChar(512)
  momoCode               String?   @map("momo_code") @db.VarChar(64)
  status                 String?   @default("completed") @db.VarChar(32)
  branch                 String?   @db.VarChar(191)
  cashier                String?   @db.VarChar(191)
  notes                  String?   @db.Text
  // Rwanda EBM fiscalisation. Written by the EBM submission flow after the
  // sale exists, which is why every field is nullable.
  ebmStatus              String?   @default("not_configured") @map("ebm_status") @db.VarChar(32)
  ebmInvoiceNo           String?   @map("ebm_invoice_no") @db.VarChar(64)
  ebmReceiptNo           String?   @map("ebm_receipt_no") @db.VarChar(64)
  ebmQrCode              String?   @map("ebm_qr_code") @db.Text
  ebmVerificationCode    String?   @map("ebm_verification_code") @db.VarChar(191)
  ebmSyncedAt            DateTime? @map("ebm_synced_at")
  userId                 String?   @map("user_id") @db.Char(36)
  date                   DateTime  @default(now())
  createdAt              DateTime  @default(now()) @map("created_at")

  // These relations were missing entirely — the model carried only the scalar
  // tenantId/userId, so Prisma emitted no foreign keys for `sales` even though
  // it did for `sale_items`. A sale was therefore tied to its workspace by
  // nothing the database enforced, and deleting a tenant left its sales behind
  // as rows no query could reach. See migration 20260810100000.
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: removing a cashier must not erase the sales they
  // recorded. The money changed hands whoever has since left.
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  saleItems     SaleItem[]
  creditedItems CreditedItem[]

  // Two sales sharing an invoice number is an accounting record that cannot
  // be reconciled, so the database refuses it rather than trusting the
  // allocator to be right. Per tenant: two businesses may both have INV-0001.
  @@unique([tenantId, invoiceNo])
  // The constraint that makes replay safe. Per tenant, so two businesses
  // generating the same key never collide.
  @@unique([tenantId, clientRequestId])
  @@index([tenantId])
  @@index([customerPhoneHash])
  @@map("sales")
}

/// One row per tenant per day, holding the last invoice number handed out.
///
/// Sequential invoice numbers used to be derived from "how many sales exist
/// today", which is only correct while requests arrive one at a time: two
/// concurrent checkouts both read the same count and both claim it. A counter
/// incremented inside the sale's own transaction cannot do that — the row lock
/// makes allocation serial, which is what sequential numbering means, and a
/// rolled-back sale gives its number back so the sequence stays gapless.
/// The month-by-month sequence behind subscription invoice numbers.
///
/// Platform-wide, not per tenant. These are ShopCore's invoices *to* its
/// customers, so a number identifies one document across the whole platform —
/// unlike `InvoiceCounter`, which numbers a shop's own sales invoices and is
/// therefore keyed by tenant. Reusing that one gave every tenant its own
/// SC-INV-YYYYMM-0001 and collided on the first customer to pay second.
model SubscriptionInvoiceCounter {
  /// YYYYMM.
  period    String @id @db.VarChar(6)
  lastValue Int    @default(0) @map("last_value")

  @@map("subscription_invoice_counters")
}

/// A receipt for one settled subscription payment.
///
/// Written only when money has actually been confirmed, so a row here is
/// evidence of payment rather than a request for it — there is no "unpaid
/// invoice" state, because an unpaid attempt is a `PaymentTransaction` and
/// already has one.
///
/// ## Why the period is stored and not derived
///
/// A subscription's `currentPeriodStart/End` move on every renewal. An invoice
/// has to say what *this* payment bought, months or years later, after the
/// subscription has moved on and possibly changed plan. Deriving it at read
/// time would silently rewrite history.
///
/// ## Why the payer is not copied here
///
/// Name, email and phone live encrypted on the `PaymentTransaction` this
/// invoice is for, and are read through the relation when one is rendered.
/// Copying them would mean a second encrypted copy of the same personal data
/// to keep in step and to erase on request, for no gain.
model SubscriptionInvoice {
  id            String  @id @default(uuid()) @db.Char(36)
  /// Human-facing, unique, and never reused: SC-INV-YYYYMM-0001.
  invoiceNo     String  @unique @map("invoice_no") @db.VarChar(32)
  tenantId      String  @map("tenant_id") @db.Char(36)
  subscriptionId String? @map("subscription_id") @db.Char(36)
  /// One invoice per settled payment. Unique, so a retried callback that
  /// reaches issuance twice cannot produce two receipts for one payment.
  transactionId String  @unique @map("transaction_id") @db.Char(36)

  planCode      String  @map("plan_code") @db.VarChar(64)
  planName      String  @map("plan_name") @db.VarChar(191)
  billingCycle  String  @map("billing_cycle") @db.VarChar(16)
  billingMonths Int     @map("billing_months")

  /// The term this payment bought. Inclusive start, exclusive end.
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")

  amount        Decimal @db.Decimal(14, 2)
  currency      String  @default("RWF") @db.VarChar(8)

  /// How it was paid, for the line the customer reads first.
  paymentMethodCode String  @map("payment_method_code") @db.VarChar(64)
  paymentMethodName String  @map("payment_method_name") @db.VarChar(191)
  providerTxnId     String? @map("provider_txn_id") @db.VarChar(128)

  paidAt    DateTime @map("paid_at")
  issuedAt  DateTime @default(now()) @map("issued_at")
  /// Whether the receipt reached the customer, and how.
  emailedAt DateTime? @map("emailed_at")
  smsSentAt DateTime? @map("sms_sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction  PaymentTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
  @@map("subscription_invoices")
}

model InvoiceCounter {
  tenantId  String @map("tenant_id") @db.Char(36)
