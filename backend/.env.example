# MySQL connection string used by Prisma.
# Default assumes a local XAMPP MySQL install (root user, no password,
# default port 3306, matching XAMPP's out-of-the-box config). Create the
# database first: mysql -uroot -e "CREATE DATABASE shopcore_v2"
DATABASE_URL="mysql://root@127.0.0.1:3306/shopcore_v2"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# JWT signing secrets - generate with `openssl rand -hex 32` in real environments
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

BCRYPT_COST=12

# PII encryption (src/lib/crypto.ts). Generate each with `openssl rand -hex 32`.
# ENCRYPTION_KEY  - AES-256-GCM data key for names, emails, phone numbers.
# BLIND_INDEX_KEY - HMAC-SHA256 key for the deterministic lookup hashes that
#                   make encrypted emails/phones searchable and uniquely
#                   constrainable.
# They must be different values, and rotating either one requires re-encrypting
# or re-hashing the affected columns - back them up with the database.
ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""

FRONTEND_URL="http://127.0.0.1:5173"

# Transactional email (password reset, etc.) via Resend - https://resend.com
RESEND_API_KEY="re_your_api_key"
# Must be a domain verified in Resend with SPF + DKIM, and the display name
# must be the product the mail is about, or it lands in spam.
RESEND_FROM_EMAIL="ShopCore <no-reply@yourdomain.com>"
RESEND_REPLY_TO="support@yourdomain.com"

# File storage (src/lib/storage.ts). "local" (default) writes under
# backend/uploads/ and serves it back via /uploads - nothing else to
# configure. Set STORAGE_DRIVER=s3 to target AWS S3, MinIO, Cloudflare R2, etc.
# "cloudinary" (per the requirements), "s3", or "local" (default, no config).
STORAGE_DRIVER="local"

# Cloudinary — required when STORAGE_DRIVER=cloudinary. Only the returned URL
# and public_id are stored in the database; Cloudinary holds the bytes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_FORCE_PATH_STYLE="false"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# SMS (HDev, Rwanda). Sent alongside email for invitations and sign-in codes.
# Leave the id/key empty in development and messages are logged instead of sent.
HDEV_API_ID="HDEV-your-api-id-ID"
HDEV_API_KEY="HDEV-your-api-key-KEY"
HDEV_SMS_URL="https://sms-api.hdev.rw/api_pay/api"
HDEV_SENDER_ID="N-SMS"
SMS_DEFAULT_COUNTRY_CODE="250"

# ---------------------------------------------------------------- payments --
# LMBTech Pay (pay.lmbtech.rw) fronts MTN Mobile Money, Airtel Money and card
# payments for subscription billing.
#
# PAYMENTS_DRIVER=mock is the development default. It never calls out: it
# accepts a collection as pending, then settles it locally a few seconds later
# through the same callback path the real gateway uses, writing the same
# payment_transactions and payment_logs rows. The whole subscription flow is
# therefore testable with no account and no public URL.
#
# Switch to "lmbtech" and supply both keys from the LMBTech dashboard to
# charge real money. Without them the server reports "gateway not configured"
# rather than sending an unauthenticated request to somebody else's system.
PAYMENTS_DRIVER="mock"
API_URL="https://pay.lmbtech.rw/pay/config/api"

# LMBTech issue a PAIR and expect HTTP Basic app_key:secret_key. A Bearer
# token of either key is refused before it reaches their payment logic:
#   401 {"status":"fail","message":"Invalid Authorization header format"}
LMB_APP_KEY=""
LMB_SECRET_KEY=""

# Superseded by the pair above. Kept so an older deployment still boots.
API_KEY=""

# How long to hold their `pay` call open. Their endpoint blocks until the
# payer approves the prompt, so we stop waiting and poll for the result
# instead of pinning a worker to one person's PIN entry.
LMB_PAY_TIMEOUT_SECONDS="8"

# Where a payment's status can be re-asked for: used when a callback arrives
# with a status we do not recognise, and when a card payer returns carrying
# only a tracking id.
LMBTECH_VERIFY_URL="https://pay.lmbtech.rw/pay/config/api.php"

# What each rail is called on the wire. Overridable so a change on the
# gateway's side is a config edit rather than a deploy.
GATEWAY_METHOD_MTN="MTN_MOMO_RWA"
GATEWAY_METHOD_AIRTEL="AIRTEL_MONEY_RWA"
GATEWAY_METHOD_CARD="card"

# Publicly reachable base of THIS API. The gateway posts payment results to
# {API_PUBLIC_URL}/api/payments/callback/lmbtech, so with the live driver this
# must be an address the gateway can actually reach (a domain, or a tunnel in
# development) - localhost only works with the mock driver.
API_PUBLIC_URL="http://127.0.0.1:4000"

# Set these only when the derived URLs are wrong (an API behind a proxy path,
# or a card return page somewhere other than the frontend's /billing route).
LMB_CALLBACK_URL=""
LMB_CARD_REDIRECT_URL=""

# How long the mock driver waits before settling a simulated collection.
MOCK_PAYMENT_SETTLE_SECONDS="4"

# Offers the RWF 100 "Test plan" on the signup and pricing screens, so a real
# payment can be put through the gateway end to end without spending a
# subscription. The plan is real and charges real money, so this MUST stay
# false in production or customers can buy it. See
# src/modules/subscription/testPlan.ts.
SHOW_TEST_PLAN="false"
